{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/black:*)",
      "Bash(.venv/bin/flake8:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(backend/.venv/bin/black:*)",
      "Bash(backend/.venv/bin/flake8:*)",
      "Bash(backend/.venv/bin/pytest:*)",
      "Bash(docker compose:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --amend:*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  }
}
